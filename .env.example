# Optional defaults. The dashboard can also send provider credentials per run.
# Secrets sent by the dashboard are used in memory and are never written to the database.
NORTHSTAR_DB_PATH=./data/northstar.db
NORTHSTAR_PROCEDURES_DIR=./procedures
NORTHSTAR_DEFAULT_PROVIDER=openai_compatible
NORTHSTAR_DEFAULT_BASE_URL=https://api.openai.com/v1
NORTHSTAR_DEFAULT_MODEL=gpt-4.1-mini
NORTHSTAR_API_KEY=
NORTHSTAR_REQUEST_TIMEOUT_SECONDS=90
NORTHSTAR_MAX_CONCURRENCY=4
